    },
    "The Controls tab lets you adjust the delay of both voices, the voice effect, and the volume of the second voice." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Controles te permite ajustar el retardo de ambas voces, el efecto de voz y el volumen de la segunda voz."
          }
        }
      }
    },
    "The microphone is used to hear your voice and return the delayed audio while you practice." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono se utiliza para captar tu voz y reproducir el audio con retardo mientras practicas."
